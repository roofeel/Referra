{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "cd ../packages/db && bunx prisma generate --schema prisma/schema.prisma",
    "db:migrate": "cd ../packages/db && bunx prisma migrate deploy --schema prisma/schema.prisma",
    "dev": "bun run db:generate && bun --hot index.ts",
    "postinstall": "cd ../packages/db && bun install && bunx prisma generate --schema prisma/schema.prisma",
    "start": "bun index.ts",
    "worker:report-export": "bun src/workers/report-export.worker.ts",
    "worker:manual-attributed": "bun src/workers/manual-attributed.worker.ts",
    "worker:all": "bun run worker:report-export & bun run worker:manual-attributed & wait"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.95",
    "@aws-sdk/client-athena": "^3.1032.0",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/credential-providers": "3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@sentry/bun": "^10.50.0",
    "ai": "^6.0.78",
    "bullmq": "^5.77.3",
    "hono": "^4.11.9",
    "ioredis": "^5.10.1",
    "zod": "^4.3.6"
  }
}
